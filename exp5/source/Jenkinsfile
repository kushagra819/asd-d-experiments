pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                echo 'Building application from GitHub...'
            }
        }
        stage('Test') {
            steps {
                echo 'Running automated tests...'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                bat 'type index.html'
            }
        }
    }
}
